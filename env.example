# Your time zone, e.g. America/New_York
TZ=

# Easier: leave ICS_URLS and WX_PLACE blank and paste them on http://<your-server>:8096/settings.
# Google: calendar.google.com > gear > Settings > your calendar (left side) > Integrate calendar >
# "Secret address in iCal format". Format is Name|url. More calendars: comma-separated,
# optional color in the middle:  Family|https://...basic.ics,Kids|#ef7aa8|https://...basic.ics
ICS_URLS=

# Weather: a city ("Portland, OR") or "lat,lon". us = °F, metric = °C.
WX_PLACE=
WX_UNITS=us

# The iPhone Shortcut sends this. Use a long random value, e.g. from: openssl rand -hex 24
LIST_TOKEN=change-me
# A list's "updated" label turns orange after this many hours without an update
LIST_STALE_H=24

# Optional photo panel from one Immich album. Leave IMMICH_URL or IMMICH_KEY blank for no photos.
IMMICH_URL=http://<your-server>:2283
IMMICH_KEY=
IMMICH_ALBUM=
